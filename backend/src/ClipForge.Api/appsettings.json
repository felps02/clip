{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5080"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 67108864
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Branding": {
    "Name": "ClipForge",
    "SupportEmail": "suporte@example.com"
  },
  "Auth": {
    "JwtSigningKey": "",
    "Issuer": "clipforge",
    "Audience": "clipforge-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "CookieSecure": false,
    "CookieDomain": "",
    "RequireConfirmedEmail": false,
    "LockoutMaxFailedAttempts": 5,
    "LockoutMinutes": 5
  },
  "Internal": {
    "ApiKey": ""
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Api": {
    "PublicBaseUrl": "http://localhost:5080",
    "WorkerBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "RefreshPerMinute": 60,
    "UploadsPerMinute": 30,
    "TransfersPerMinute": 600,
    "AssistantPerMinute": 20
  },
  "Storage": {
    "Provider": "Local",
    "SigningKey": "",
    "Local": {
      "RootPath": "%LOCALAPPDATA%\\ClipForge\\storage"
    },
    "S3": {
      "Bucket": "clipforge",
      "ServiceUrl": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  },
  "Media": {
    "UploadUrlMinutes": 120,
    "DownloadUrlMinutes": 15,
    "PreviewUrlMinutes": 30,
    "ThumbnailUrlMinutes": 60
  },
  "Email": {
    "Provider": "Log",
    "From": "no-reply@example.com",
    "FromName": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseStartTls": true
    }
  },
  "Jobs": {
    "LeaseSeconds": 180,
    "MaxAttempts": 3,
    "ReaperIntervalSeconds": 30,
    "SourceUrlHours": 12
  },
  "Live": {
    "SessionTimeoutMinutes": 10,
    "MaxSegmentMb": 512,
    "ReaperIntervalSeconds": 30
  },
  "Retention": {
    "TempUploadHours": 24,
    "CleanupIntervalMinutes": 15,
    "AccountPurgeDelayHours": 24
  },
  "Assistant": {
    "Provider": "local",
    "TimeoutSeconds": 60,
    "StatusCacheSeconds": 10,
    "Local": {
      "BaseUrl": "http://127.0.0.1:8090",
      "Model": "",
      "WarmupOnStartup": true
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-2.5-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "ThinkingBudget": 0
    }
  },
  "Payments": {
    "Provider": "None",
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": ""
    }
  },
  "Plans": {
    "free": {
      "Name": "Gratuito",
      "Description": "Para experimentar: 60 minutos de processamento por mês.",
      "IsActive": true,
      "SortOrder": 0,
      "PriceMonthlyCents": 0,
      "Currency": "BRL",
      "ProviderPriceId": null,
      "Limits": {
        "MonthlyProcessingMinutes": 60,
        "MaxSourceDurationMinutes": 120,
        "MaxFileSizeMb": 2048,
        "MaxActiveProjects": 3,
        "MaxCandidatesPerJob": 15,
        "MaxAutoRenderPerJob": 15,
        "MaxRendersPerMonth": 10,
        "MaxRenderHeight": 720,
        "MaxConcurrentJobs": 1,
        "Priority": 0,
        "RetentionDays": 7,
        "StorageQuotaGb": 5,
        "TranscriptionModel": "base",
        "AllowWebcamLayout": false,
        "AllowCustomSubtitleStyles": false,
        "AssistantMessagesPerMonth": 100
      },
      "Features": [
        "60 minutos de processamento por mês",
        "Até 3 projetos ativos",
        "Clipes em 720p",
        "Legendas automáticas"
      ]
    },
    "creator": {
      "Name": "Creator",
      "Description": "Para criadores que publicam toda semana.",
      "IsActive": true,
      "SortOrder": 1,
      "PriceMonthlyCents": null,
      "Currency": "BRL",
      "ProviderPriceId": null,
      "Limits": {
        "MonthlyProcessingMinutes": 600,
        "MaxSourceDurationMinutes": 360,
        "MaxFileSizeMb": 8192,
        "MaxActiveProjects": 20,
        "MaxCandidatesPerJob": 30,
        "MaxAutoRenderPerJob": 30,
        "MaxRendersPerMonth": 200,
        "MaxRenderHeight": 1080,
        "MaxConcurrentJobs": 2,
        "Priority": 1,
        "RetentionDays": 30,
        "StorageQuotaGb": 50,
        "TranscriptionModel": "small",
        "AllowWebcamLayout": true,
        "AllowCustomSubtitleStyles": true,
        "AssistantMessagesPerMonth": 1000
      },
      "Features": [
        "600 minutos de processamento por mês",
        "Até 20 projetos ativos",
        "Clipes em 1080p",
        "Layout com webcam",
        "Estilos de legenda personalizados",
        "Prioridade na fila"
      ]
    },
    "pro": {
      "Name": "Pro",
      "Description": "Para quem produz em volume.",
      "IsActive": true,
      "SortOrder": 2,
      "PriceMonthlyCents": null,
      "Currency": "BRL",
      "ProviderPriceId": null,
      "Limits": {
        "MonthlyProcessingMinutes": 2400,
        "MaxSourceDurationMinutes": 720,
        "MaxFileSizeMb": 20480,
        "MaxActiveProjects": 0,
        "MaxCandidatesPerJob": 50,
        "MaxAutoRenderPerJob": 50,
        "MaxRendersPerMonth": 0,
        "MaxRenderHeight": 1080,
        "MaxConcurrentJobs": 3,
        "Priority": 2,
        "RetentionDays": 90,
        "StorageQuotaGb": 200,
        "TranscriptionModel": "small",
        "AllowWebcamLayout": true,
        "AllowCustomSubtitleStyles": true,
        "AssistantMessagesPerMonth": 5000
      },
      "Features": [
        "2400 minutos de processamento por mês",
        "Projetos ilimitados",
        "Renderizações ilimitadas",
        "Clipes em 1080p",
        "Layout com webcam",
        "Máxima prioridade na fila",
        "Retenção de 90 dias"
      ]
    }
  }
}
