{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "ClipForge": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=clipforge;Username=clipforge;Password=clipforge",
    "Test": "Host=localhost;Port=5432;Database=clipforge_test;Username=clipforge;Password=clipforge"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "JwtSigningKey": "dev-only-jwt-signing-key-change-me-0123456789abcdef",
    "CookieSecure": false,
    "RequireConfirmedEmail": false
  },
  "Internal": {
    "ApiKey": "change-me-internal-key"
  },
  "Storage": {
    "Provider": "Local",
    "SigningKey": "dev-only-storage-signing-key-change-me-0123456789",
    "Local": {
      "RootPath": "%LOCALAPPDATA%\\ClipForge\\storage"
    }
  },
  "Api": {
    "PublicBaseUrl": "http://localhost:5080",
    "WorkerBaseUrl": "http://localhost:5080"
  },
  "Email": {
    "Provider": "Log"
  },
  "Payments": {
    "Provider": "None"
  }
}
