# Copy to `.env.local` (never committed). Values prefixed with NEXT_PUBLIC_ are inlined at build time.

# Base URL of the ClipForge API (no trailing slash). `{host}` is replaced at runtime by the host name
# the page was opened with (`localhost` during SSR), so one build serves localhost and LAN addresses.
# Unset = http://{host}:5080. A fixed URL (https://api.example.com) is used as is.
NEXT_PUBLIC_API_BASE_URL=http://{host}:5080

# Server-side auth guard (src/proxy.ts): app routes without the API's `cf_access` cookie go to
# /login. It needs that cookie on the web host: same host (localhost:3000 + localhost:5080 is
# fine) or, on different hosts, `Auth__CookieDomain` on the API covering both. If neither is
# possible set this to false: the proxy stops redirecting and the app layout's client-side guard
# (GET /api/auth/me) handles authentication.
NEXT_PUBLIC_COOKIE_GUARD=true

# Public brand name shown in the UI (the codename is only a fallback).
NEXT_PUBLIC_BRAND_NAME=ClipForge

# Support e-mail shown in the footer and legal pages. Leave empty to hide the "Suporte" links.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Legal identity printed in the Terms of use and Privacy policy. The pages are only published
# when ALL of these (and the support e-mail) are set; otherwise they show "ainda não publicado".
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_CNPJ=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_FORUM=
NEXT_PUBLIC_LEGAL_DPO_EMAIL=
# ISO date of the last legal review, e.g. 2026-10-22
NEXT_PUBLIC_LEGAL_UPDATED_AT=

# Download link of the OBS companion. Leave empty while it is not distributed: the Lives page
# and Settings → Integrações then say it is still in development.
NEXT_PUBLIC_COMPANION_DOWNLOAD_URL=
