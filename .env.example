# ============================================================================
# ClipForge — environment template. Copy to `.env` (never commit `.env`).
# The API reads these as ASP.NET configuration (double underscore = section).
# The processing service and the frontend read their own prefixed variables.
# ============================================================================

# ---------------------------------------------------------------- Branding --
Branding__Name=ClipForge
Branding__SupportEmail=suporte@example.com
NEXT_PUBLIC_BRAND_NAME=ClipForge

# ---------------------------------------------------------------- Database --
ConnectionStrings__Default=Host=localhost;Port=5432;Database=clipforge;Username=clipforge;Password=clipforge
# Used only by the integration test suite
ConnectionStrings__Test=Host=localhost;Port=5432;Database=clipforge_test;Username=clipforge;Password=clipforge

# -------------------------------------------------------------------- Auth --
# At least 32 random characters. Generate: openssl rand -base64 48
Auth__JwtSigningKey=change-me-to-a-random-string-with-at-least-32-characters
Auth__Issuer=clipforge
Auth__Audience=clipforge-web
Auth__AccessTokenMinutes=15
Auth__RefreshTokenDays=30
# true in production (cookies only over HTTPS)
Auth__CookieSecure=false
# Optional Domain of the auth cookies (cf_access, cf_refresh). Empty = host-only cookies of the API
# host. Set it when web and API run on different subdomains so the web sees cf_access, e.g.
# example.com for app.example.com + api.example.com (must be the API host or a parent of it).
Auth__CookieDomain=
# Require e-mail confirmation before login (needs a working Email provider)
Auth__RequireConfirmedEmail=false

# ---------------------------------------------------------- Internal API ----
# Shared secret between the API and the processing worker (header X-Internal-Api-Key)
Internal__ApiKey=change-me-internal-key
CLIPFORGE_INTERNAL_API_KEY=change-me-internal-key

# ------------------------------------------------------------------ URLs ----
Frontend__BaseUrl=http://localhost:3000
Api__PublicBaseUrl=http://localhost:5080
# Base URL the processing worker uses to reach the API (differs from PublicBaseUrl inside Docker)
Api__WorkerBaseUrl=http://localhost:5080
Cors__AllowedOrigins__0=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
# Web auth guard on the API's cf_access cookie (default true). Production deployments with web and
# API on different hosts must set Auth__CookieDomain on the API to a domain covering both (e.g.
# .example.com for app.example.com + api.example.com), or set this to false so only the web's
# client-side guard applies. Otherwise the login page cannot hand off to the app.
NEXT_PUBLIC_COOKIE_GUARD=true
CLIPFORGE_API_BASE_URL=http://localhost:5080

# --------------------------------------------------------------- Storage ----
# Local = files on disk, signed URLs served by the API. S3 = any S3-compatible bucket (MinIO, AWS, R2).
Storage__Provider=Local
Storage__Local__RootPath=%LOCALAPPDATA%\ClipForge\storage
# HMAC key for signed download/upload URLs in Local mode (>= 32 chars)
Storage__SigningKey=change-me-storage-signing-key-32-chars-min
Storage__S3__Bucket=clipforge
Storage__S3__ServiceUrl=http://localhost:9000
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=minioadmin
Storage__S3__SecretKey=minioadmin
Storage__S3__ForcePathStyle=true

# ------------------------------------------------------------------ Email ----
# Log = print e-mails to the log (development). Smtp = real delivery.
Email__Provider=Log
Email__From=no-reply@example.com
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__UseStartTls=true

# ------------------------------------------------------------------- Jobs ----
Jobs__LeaseSeconds=180
Jobs__MaxAttempts=3
Jobs__ReaperIntervalSeconds=30
Retention__TempUploadHours=24

# --------------------------------------------------------------- Payments ----
# None = billing endpoints report "not configured". Stripe = Checkout + webhooks.
Payments__Provider=None
Payments__Stripe__SecretKey=
Payments__Stripe__WebhookSecret=
# Price ids per plan (Stripe). Limits and prices live in appsettings "Plans" (overridable here).
Plans__creator__ProviderPriceId=
Plans__pro__ProviderPriceId=

# -------------------------------------------------------------- Assistant ----
# The settings assistant (chat on /new) uses the product's own AI or a free provider, never a paid API:
#   local  = llama.cpp llama-server (OpenAI-compatible) serving Qwen3-1.7B Q4_K_M; start it with
#            scripts/dev-llm.ps1 (Windows) or the Docker "llm" service (http://llm:8090 inside Docker)
#   gemini = Google Gemini API free tier (key from Google AI Studio). On the free tier Google may use
#            prompts and responses to improve its products (human review possible): disclose it (LGPD).
#   none   = assistant off (status "unavailable", chat answers 503)
Assistant__Provider=local
Assistant__Local__BaseUrl=http://127.0.0.1:8090
# Label shown by GET /api/assistant/status (empty = the model file the server reports)
Assistant__Local__Model=
# Secret: set it only in .env / user-secrets, never in appsettings
Assistant__Gemini__ApiKey=
# Verify the model id in Google AI Studio (free tier: Flash models)
Assistant__Gemini__Model=gemini-2.5-flash
# Upper bound of one model call in seconds (a cold prompt cache on a busy CPU is the slowest case)
Assistant__TimeoutSeconds=60
# Chat messages per user and minute (plans also cap messages per month: assistantMessagesPerMonth)
RateLimiting__AssistantPerMinute=20

# ------------------------------------------------------- Media providers ----
# Optional: used only to read public metadata through official APIs.
Providers__YouTube__ApiKey=
Providers__Twitch__ClientId=
Providers__Twitch__ClientSecret=

# ------------------------------------------------------------ Processing ----
WORKER_ENABLED=true
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_SECONDS=2
MAX_PARALLEL_JOBS=1
FFMPEG_PATH=%LOCALAPPDATA%\ClipForge\tools\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=%LOCALAPPDATA%\ClipForge\tools\ffmpeg\bin\ffprobe.exe
FFMPEG_THREADS=0
WORK_DIR=%LOCALAPPDATA%\ClipForge\work
# before each clip an analysis renders: below this free space (MB) on the WORK_DIR volume the
# remaining clips are skipped with a warning event (0 disables the check)
RENDER_MIN_FREE_MB=500
MODELS_DIR=%LOCALAPPDATA%\ClipForge\models
# faster-whisper: the largest model a job may use (the plan picks base or small per job through
# limits.transcriptionModel); small ~480 MB, about 3x the CPU time of base. false disables transcription.
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional LLM of the worker (re-rank against the user's instructions/focus + pt-BR clip titles):
# local (the product's own model: the same llama-server as the assistant, scripts/dev-llm.ps1) |
# gemini (free tier, see Assistant above) | none (analysis without LLM, signals.llm.available=false) |
# anthropic (paid, opt-in only)
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8090
LLM_TIMEOUT_SECONDS=60
LLM_BUDGET_SECONDS=100
# Gemini free tier (Google AI Studio key): Google may use free-tier prompts to improve its products.
# Verify the model id in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only with LLM_PROVIDER=anthropic (paid, opt-in):
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8008
